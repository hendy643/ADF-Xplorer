<Project Sdk="WixToolset.Sdk/7.0.0">

  <PropertyGroup>
    <!-- https://wixtoolset.org/osmf/ - accepts the WiX v7 Open Source Maintenance Fee EULA -->
    <AcceptEula>wix7</AcceptEula>
    <OutputType>Package</OutputType>
    <Platforms>x64</Platforms>
    <!-- MSI ProductVersion only supports numeric Major.Minor.Build - no semver prerelease/metadata suffix.
         CI passes -p:InstallerVersion=X.Y.Z alongside the full -p:Version for the app assemblies. -->
    <InstallerVersion Condition="'$(InstallerVersion)'==''">$(Version)</InstallerVersion>
    <DefineConstants>PublishDir=$(MSBuildThisFileDirectory)..\AdfXplorer.WinFsp\bin\x64\$(Configuration)\net10.0-windows\win-x64\publish\;ProductVersion=$(InstallerVersion)</DefineConstants>
    <OutputName>AdfXplorer-$(InstallerVersion)</OutputName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="7.0.0" />
  </ItemGroup>

</Project>
