<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="AdfXplorer"
           Manufacturer="AdfXplorer"
           Version="$(var.ProductVersion)"
           UpgradeCode="9c9c8f0e-6e9a-4a2b-9d5b-9c0e6e6b2b4f"
           Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="..\..\res\adfxplorer.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <ui:WixUI Id="WixUI_InstallDir" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="AdfXplorer">
        <Component Id="AppExecutable" Guid="6d9f8c9a-6e63-4c8b-9e40-5a2f6a4a1a1a">
          <!--
            Registers the .adf/.hdf file association declaratively (HKCR, since this package is
            perMachine) instead of the app self-registering via a CLI verb - WiX authors and removes
            this automatically at install/uninstall time, no custom action needed. AdfXplorer has no
            other Explorer integration (no right-click "Unmount" on drives) - it's tray-only otherwise.
          -->
          <File Id="AppExe" Source="$(PublishDir)adfxplorer.exe" KeyPath="yes" />
          <ProgId Id="AdfXplorer.AdfFile" Description="Amiga Floppy Disk Image" Icon="AppExe" IconIndex="0">
            <Extension Id="adf">
              <Verb Id="open" Command="Mount with AdfXplorer" TargetFile="AppExe" Argument="mount &quot;%1&quot;" />
            </Extension>
          </ProgId>
          <ProgId Id="AdfXplorer.HdfFile" Description="Amiga Hard Disk Image" Icon="AppExe" IconIndex="0">
            <Extension Id="hdf">
              <Verb Id="open" Command="Mount with AdfXplorer" TargetFile="AppExe" Argument="mount &quot;%1&quot;" />
            </Extension>
          </ProgId>

          <!--
            The "Capabilities"/RegisteredApplications registration below is what makes Windows' own
            Default Apps / "Open with" picker list AdfXplorer as a distinct, named application capable
            of opening .adf/.hdf (with its own icon and description), rather than the extension-to-ProgId
            mapping above merely working silently as the de facto default with no discoverable identity.
          -->
          <RegistryValue Root="HKLM" Key="SOFTWARE\RegisteredApplications" Name="AdfXplorer" Type="string" Value="SOFTWARE\AdfXplorer\Capabilities" />
          <RegistryValue Root="HKLM" Key="SOFTWARE\AdfXplorer\Capabilities" Name="ApplicationName" Type="string" Value="AdfXplorer" />
          <RegistryValue Root="HKLM" Key="SOFTWARE\AdfXplorer\Capabilities" Name="ApplicationDescription" Type="string" Value="Mounts Amiga .adf/.hdf disk images as Windows drives" />
          <RegistryValue Root="HKLM" Key="SOFTWARE\AdfXplorer\Capabilities" Name="ApplicationIcon" Type="string" Value="[#AppExe],0" />
          <RegistryValue Root="HKLM" Key="SOFTWARE\AdfXplorer\Capabilities\FileAssociations" Name=".adf" Type="string" Value="AdfXplorer.AdfFile" />
          <RegistryValue Root="HKLM" Key="SOFTWARE\AdfXplorer\Capabilities\FileAssociations" Name=".hdf" Type="string" Value="AdfXplorer.HdfFile" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!--
      The app is framework-dependent now (see AdfXplorer.WinFsp.csproj - AdfXplorer.Bundle chains in
      the .NET 10 Desktop Runtime instead), so `dotnet publish` drops several dependency DLLs/config
      files alongside adfxplorer.exe rather than one self-contained exe. Harvested automatically here
      instead of listed by hand so adding a new dependency doesn't require touching this file.
    -->
    <ComponentGroup Id="AppDependencies" Directory="INSTALLFOLDER">
      <Files Include="$(PublishDir)*.dll" />
      <Files Include="$(PublishDir)*.json" />
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppProgramsFolder" Name="AdfXplorer">
        <Component Id="AppShortcut" Guid="2b6b6d0a-2e8d-4b0d-9b2f-3f2b6a9c9d1e">
          <Shortcut Id="AppStartMenuShortcut"
                    Name="AdfXplorer"
                    Target="[INSTALLFOLDER]adfxplorer.exe"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="AppIcon" />
          <RemoveFolder Id="RemoveAppProgramsFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\AdfXplorer" Name="installed" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="AdfXplorer" Level="1">
      <ComponentRef Id="AppExecutable" />
      <ComponentGroupRef Id="AppDependencies" />
      <ComponentRef Id="AppShortcut" />
    </Feature>

  </Package>
</Wix>
